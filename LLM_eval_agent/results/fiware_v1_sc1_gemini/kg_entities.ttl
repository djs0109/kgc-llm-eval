@prefix bacnet: <http://data.ashrae.org/bacnet/2020#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix bsh: <https://brickschema.org/schema/BrickShape#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudtqk: <http://qudt.org/vocab/quantitykind/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://w3id.org/rec#> .
@prefix ref: <https://brickschema.org/schema/Brick/ref#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sdo: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix tag: <https://brickschema.org/schema/BrickTag#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Hotel Entity
<http://example.com/Hotel/fiware_hotel> a rec:Building .

# Ambient Temperature Sensor
<http://example.com/AmbientTemperatureSensor/AmbientTemperatureSensor> a brick:Outside_Air_Temperature_Sensor ;
    brick:hasLocation <http://example.com/Hotel/fiware_hotel> ;
    rdf:value <https://fiware.eonerc.rwth-aachen.de/v2/entities/AmbientTemperatureSensor/attrs/temperatureAmb/value> .

# Hotel Room
<http://example.com/HotelRoom/HotelRoom:fiware_room_base_1_v1> a rec:Room ;
    brick:hasLocation <http://example.com/Hotel/fiware_hotel> .

# Temperature Sensor
<http://example.com/TemperatureSensor/TemperatureSensor:fiware_room_base_1_v1> a brick:Temperature_Sensor ;
    brick:hasLocation <http://example.com/HotelRoom/HotelRoom:fiware_room_base_1_v1> ;
    rdf:value <https://fiware.eonerc.rwth-aachen.de/v2/entities/TemperatureSensor:fiware_room_base_1_v1/attrs/temperature/value> .

# CO2 Sensor
<http://example.com/CO2Sensor/CO2Sensor:fiware_room_base_1_v1> a brick:CO2_Level_Sensor ;
    brick:hasLocation <http://example.com/HotelRoom/HotelRoom:fiware_room_base_1_v1> ;
    rdf:value <https://fiware.eonerc.rwth-aachen.de/v2/entities/CO2Sensor:fiware_room_base_1_v1/attrs/co2/value> .

# Presence Sensor
<http://example.com/PresenceSensor/PresenceSensor:fiware_room_base_1_v1> a brick:PIR_Sensor ;
    brick:hasLocation <http://example.com/HotelRoom/HotelRoom:fiware_room_base_1_v1> ;
    rdf:value <https://fiware.eonerc.rwth-aachen.de/v2/entities/PresenceSensor:fiware_room_base_1_v1/attrs/pir/value> .

# Fresh Air Ventilation & Extra Node
<http://example.com/FreshAirVentilation/FreshAirVentilation:fiware_room_base_1_v1> a brick:Ventilation_Air_System ;
    brick:hasLocation <http://example.com/HotelRoom/HotelRoom:fiware_room_base_1_v1> ;
    brick:hasPoint <http://example.com/Air_Flow_Setpoint/FreshAirVentilation:fiware_room_base_1_v1_airFlowSetpoint> .

<http://example.com/Air_Flow_Setpoint/FreshAirVentilation:fiware_room_base_1_v1_airFlowSetpoint> a brick:Air_Flow_Setpoint ;
    brick:isPointOf <http://example.com/FreshAirVentilation/FreshAirVentilation:fiware_room_base_1_v1> ;
    rdf:value <https://fiware.eonerc.rwth-aachen.de/v2/entities/FreshAirVentilation:fiware_room_base_1_v1/attrs/airFlowSetpoint/value> .

# Radiator Thermostat & Extra Node
<http://example.com/RadiatorThermostat/RadiatorThermostat:fiware_room_base_1_v1> a brick:Thermostat ;
    brick:hasLocation <http://example.com/HotelRoom/HotelRoom:fiware_room_base_1_v1> ;
    brick:hasPoint <http://example.com/Temperature_Setpoint/RadiatorThermostat:fiware_room_base_1_v1_temperatureSetpoint> .

<http://example.com/Temperature_Setpoint/RadiatorThermostat:fiware_room_base_1_v1_temperatureSetpoint> a brick:Temperature_Setpoint ;
    brick:isPointOf <http://example.com/RadiatorThermostat/RadiatorThermostat:fiware_room_base_1_v1> ;
    rdf:value <https://fiware.eonerc.rwth-aachen.de/v2/entities/RadiatorThermostat:fiware_room_base_1_v1/attrs/temperatureSetpoint/value> .

# Cooling Coil & Extra Node
<http://example.com/CoolingCoil/CoolingCoil:fiware_room_base_1_v1> a brick:Cooling_Coil ;
    brick:hasLocation <http://example.com/HotelRoom/HotelRoom:fiware_room_base_1_v1> ;
    brick:hasPoint <http://example.com/Speed_Setpoint/CoolingCoil:fiware_room_base_1_v1_fanSpeed> .

<http://example.com/Speed_Setpoint/CoolingCoil:fiware_room_base_1_v1_fanSpeed> a brick:Speed_Setpoint ;
    brick:isPointOf <http://example.com/CoolingCoil/CoolingCoil:fiware_room_base_1_v1> ;
    rdf:value <https://fiware.eonerc.rwth-aachen.de/v2/entities/CoolingCoil:fiware_room_base_1_v1/attrs/fanSpeed/value> .