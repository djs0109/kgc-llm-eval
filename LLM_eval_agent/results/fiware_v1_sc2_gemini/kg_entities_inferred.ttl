<http://example.com/AmbientTemperatureSensor/AmbientTemperatureSensor> a owl:Thing,
        brick:Air_Temperature_Sensor,
        brick:Class,
        brick:Entity,
        brick:Outside_Air_Temperature_Sensor,
        brick:Point,
        brick:Sensor,
        brick:Temperature_Sensor ;
    rdf:value <https://fiware.eonerc.rwth-aachen.de/v2/entities/AmbientTemperatureSensor/attrs/temperatureAmb/value> ;
    owl:sameAs <http://example.com/AmbientTemperatureSensor/AmbientTemperatureSensor> ;
    brick:Relationship <http://example.com/Hotel/fiware_hotel> ;
    brick:hasLocation <http://example.com/Hotel/fiware_hotel> ;
    rec:locatedIn <http://example.com/Hotel/fiware_hotel> .

<http://example.com/CO2Sensor/CO2Sensor:fiware_room_base_1_v1> a owl:Thing,
