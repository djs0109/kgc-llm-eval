@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<http://example.com/AmbientTemperatureSensor/AmbientTemperatureSensor> a brick:Outside_Air_Temperature_Sensor ;
    rdf:value <https://fiware.eonerc.rwth-aachen.de/v2/entities/AmbientTemperatureSensor/attrs/temperatureAmb/value> ;
    brick:hasLocation <http://example.com/Hotel/fiware_hotel> .

<http://example.com/CO2Sensor/CO2Sensor:fiware_room_base_1_v1> a brick:CO2_Level_Sensor ;
    rdf:value <https://fiware.eonerc.rwth-aachen.de/v2/entities/CO2Sensor:fiware_room_base_1_v1/attrs/co2/value> ;
    brick:hasLocation <http://example.com/HotelRoom/HotelRoom:fiware_room_base_1_v1> .

<http://example.com/CoolingCoil/CoolingCoil:fiware_room_base_1_v1> a brick:Cooling_Coil ;
    brick:hasLocation <http://example.com/HotelRoom/HotelRoom:fiware_room_base_1_v1> ;
    brick:hasPoint <http://example.com/brick:Speed_Status/CoolingCoil:fiware_room_base_1_v1> .

<http://example.com/FreshAirVentilation/FreshAirVentilation:fiware_room_base_1_v1> a brick:Ventilation_Air_System ;
    brick:hasLocation <http://example.com/HotelRoom/HotelRoom:fiware_room_base_1_v1> ;
    brick:hasPoint <http://example.com/brick:Air_Flow_Setpoint/FreshAirVentilation:fiware_room_base_1_v1> .

<http://example.com/PresenceSensor/PresenceSensor:fiware_room_base_1_v1> a brick:PIR_Sensor ;
    rdf:value <https://fiware.eonerc.rwth-aachen.de/v2/entities/PresenceSensor:fiware_room_base_1_v1/attrs/pir/value> ;
    brick:hasLocation <http://example.com/HotelRoom/HotelRoom:fiware_room_base_1_v1> .

<http://example.com/RadiatorThermostat/RadiatorThermostat:fiware_room_base_1_v1> a brick:Radiator ;
    brick:hasLocation <http://example.com/HotelRoom/HotelRoom:fiware_room_base_1_v1> ;
    brick:hasPoint <http://example.com/brick:Temperature_Setpoint/RadiatorThermostat:fiware_room_base_1_v1> .

<http://example.com/TemperatureSensor/TemperatureSensor:fiware_room_base_1_v1> a brick:Air_Temperature_Sensor ;
    rdf:value <https://fiware.eonerc.rwth-aachen.de/v2/entities/TemperatureSensor:fiware_room_base_1_v1/attrs/temperature/value> ;
    brick:hasLocation <http://example.com/HotelRoom/HotelRoom:fiware_room_base_1_v1> .

<http://example.com/brick:Air_Flow_Setpoint/FreshAirVentilation:fiware_room_base_1_v1> a brick:Air_Flow_Setpoint ;
    rdf:value <https://fiware.eonerc.rwth-aachen.de/v2/entities/FreshAirVentilation:fiware_room_base_1_v1/attrs/airFlowSetpoint/value> .

<http://example.com/brick:Speed_Status/CoolingCoil:fiware_room_base_1_v1> a brick:Speed_Status ;
    rdf:value <https://fiware.eonerc.rwth-aachen.de/v2/entities/CoolingCoil:fiware_room_base_1_v1/attrs/fanSpeed/value> .

<http://example.com/brick:Temperature_Setpoint/RadiatorThermostat:fiware_room_base_1_v1> a brick:Temperature_Setpoint ;
    rdf:value <https://fiware.eonerc.rwth-aachen.de/v2/entities/RadiatorThermostat:fiware_room_base_1_v1/attrs/temperatureSetpoint/value> .

<http://example.com/Hotel/fiware_hotel> a brick:Building .

<http://example.com/HotelRoom/HotelRoom:fiware_room_base_1_v1> a brick:Room ;
    brick:hasLocation <http://example.com/Hotel/fiware_hotel> .

